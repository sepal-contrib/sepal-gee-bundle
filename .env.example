# SEPAL connection (for local development)
# SEPAL_HOST=https://sepal.io
# LOCAL_SEPAL_USER=
# LOCAL_SEPAL_PASSWORD=

# EE credentials path (for Docker)
# EE_CREDENTIALS_PATH=${HOME}/.config/earthengine/credentials

# Test mode: bypasses SEPAL header auth, uses local EE credentials
# Set to true for local development, false for production/SEPAL deployment
SOLARA_TEST=true
