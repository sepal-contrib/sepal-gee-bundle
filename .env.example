# SEPAL connection (for local development)
# SEPAL_HOST=sepal.io
# LOCAL_SEPAL_USER=
# LOCAL_SEPAL_PASSWORD=

# Earth Engine credentials for the container; the app-launcher sets the platform key.
# EE_CREDENTIALS_PATH=${HOME}/.config/earthengine/credentials

# Developer login: arm it to run against a real SEPAL instance from a machine
# where no SEPAL proxy injects the auth headers. It logs in once with the
# credentials above and serves that one identity to the whole process, so it is
# a development switch only -- never use it to serve users. Real SEPAL headers
# always win over it, so leaving it armed cannot displace a live user.
PYSEPAL_DEV_AUTH=false
